From 14a69a0a59ae9c9d053056cb47bd807fe04a8da6 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 14:57:16 +1100
Subject: [PATCH 4/4] Report a fuzz lead when the sequence ends with C-x C-c

C-x C-c ends a sequence through exit(), with status 0, so runChild called it
clean and any lead it had was dropped.  With truncated UTF-8 lines added, that hid
556 of 2,077 seeds.  It now also looks in what the child wrote to stderr.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01947MBgCkoERXfoyRGfCmQi
---
 tests/fuzz_keys.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/tests/fuzz_keys.c b/tests/fuzz_keys.c
index 40f0a05..4edec20 100644
--- a/tests/fuzz_keys.c
+++ b/tests/fuzz_keys.c
@@ -559,6 +559,20 @@ static void showKeys(void) {
 
 /* ---- forking driver --------------------------------------------------- */
 
+/* Did the child write a lead?  C-x C-c ends a sequence through exit(),
+ * with status 0, so the status alone can't say. */
+static int childWroteLead(const char *errpath) {
+	FILE *f = fopen(errpath, "r");
+	char line[1024];
+	int found = 0;
+	if (!f)
+		return 0;
+	while (!found && fgets(line, sizeof(line), f))
+		found = strncmp(line, "LEAD at key", 11) == 0;
+	fclose(f);
+	return found;
+}
+
 /* Run one sequence in a child.  Returns the child's status class:
  * 0 clean, 1 sanitizer/crash, 2 hang, 3 lead only.  The child's stderr
  * goes to errpath. */
@@ -581,7 +595,7 @@ static int runChild(uint32_t seed, const char *errpath, int timeout_s) {
 			if (WIFEXITED(status)) {
 				int code = WEXITSTATUS(status);
 				if (code == 0)
-					return 0;
+					return childWroteLead(errpath) ? 3 : 0;
 				if (code == 4)
 					return 3;
 				if (code == 3)
