+/* ---- the file path rule ---- */
+
+void test_path_rule(void) {
+	TEST_ASSERT_TRUE(pathNameAllowed("plain.c"));
+	TEST_ASSERT_TRUE(pathNameAllowed("dir/\xe6\x97\xa5\xe6\x9c\xac.txt"));
+	TEST_ASSERT_TRUE(pathNameAllowed("sp ace"));
+	/* Encoded C1 is valid UTF-8 and not C0: the rule allows it. */
+	TEST_ASSERT_TRUE(pathNameAllowed("c1\xc2\x85"));
+	TEST_ASSERT_FALSE(pathNameAllowed("a\nb"));
+	TEST_ASSERT_FALSE(pathNameAllowed("a\tb"));
+	TEST_ASSERT_FALSE(pathNameAllowed("a\x01"));
+	TEST_ASSERT_FALSE(pathNameAllowed("a\x1f"));
+	TEST_ASSERT_FALSE(pathNameAllowed("a\x7f"));
+	TEST_ASSERT_FALSE(pathNameAllowed("a\xff"));
+	TEST_ASSERT_FALSE(pathNameAllowed("a\xc3"));
+}
+
+void test_set_filename_refused_keeps_old_name(void) {
+	struct buffer *buf = make_test_buffer("x");
+	TEST_ASSERT_EQUAL_INT(0, bufferSetFilename(buf, "old"));
+	TEST_ASSERT_EQUAL_INT(-1, bufferSetFilename(buf, "a\nb"));
+	TEST_ASSERT_EQUAL_STRING("old", buf->filename);
+	/* Its own name, freed only after the copy. */
+	TEST_ASSERT_EQUAL_INT(0, bufferSetFilename(buf, buf->filename));
+	TEST_ASSERT_EQUAL_STRING("old", buf->filename);
+}
+
+/* Caller 1: editorOpen, and so every route that opens a file. */
+void test_open_refuses_bad_path_that_exists(void) {
+	owSetup();
+	const char *bad[] = { "x\ty", "x\ny", "x\x7fy", "x\xffy" };
+	struct buffer *buf = make_test_buffer(NULL);
+	for (size_t i = 0; i < sizeof(bad) / sizeof(bad[0]); i++) {
+		char p[128];
+		owWrite(bad[i], "theirs\n");
+		owPath(p, sizeof(p), bad[i]);
+		TEST_ASSERT_EQUAL_INT(-1, editorOpen(buf, p));
+		TEST_ASSERT_NULL(buf->filename);
+		TEST_ASSERT_NULL(switchToFile(p));
+		TEST_ASSERT_EQUAL_STRING("theirs\n", owRead(bad[i]));
+		unlink(p);
+	}
+	owTeardown();
+}
+
+/* The keys for typing the path of x<TAB>y, then RET, then y.  The y
+ * would answer an overwrite prompt; if none is asked it stays unread. */
+static void owRunBadName(void (*fn)(void)) {
+	char p[128];
+	owPath(p, sizeof(p), "x");
+	int keys[64];
+	int n = 0;
+	for (const char *q = p; *q && n < 56; q++)
+		keys[n++] = (unsigned char)*q;
+	keys[n++] = CTRL('q');
+	keys[n++] = '\t';
+	keys[n++] = 'y';
+	keys[n++] = '\r';
+	keys[n++] = 'y';
+	scriptKeys(keys, n);
+	muteStdout();
+	fn();
+	unmuteStdout();
+}
+
+/* Caller 2: the first save.  Refused before the overwrite prompt, with
+ * the name, the buffer's state and the file on disk as they were. */
+void test_first_save_refuses_bad_path_without_asking(void) {
+	owSetup();
+	char p[128];
+	owWrite("x\ty", "precious\n");
+	owPath(p, sizeof(p), "x\ty");
+	struct buffer *buf = make_test_buffer("mine");
+	buf->dirty = 1;
+
+	owRunBadName(doSave);
+
+	TEST_ASSERT_EQUAL_INT(test_key_count - 1, test_key_pos);
+	clearKeys();
+	TEST_ASSERT_NULL(buf->filename);
+	TEST_ASSERT_TRUE(buf->dirty);
+	TEST_ASSERT_EQUAL_STRING("precious\n", owRead("x\ty"));
+	unlink(p);
+	owTeardown();
+}
+
+/* And on a special buffer, which also asks for a name. */
+void test_first_save_of_special_buffer_stays_special_on_refusal(void) {
+	owSetup();
+	struct buffer *buf = make_test_buffer("mine");
+	buf->filename = xstrdup("*scratch*");
+	buf->special_buffer = 1;
+
+	owRunBadName(doSave);
+	clearKeys();
+
+	TEST_ASSERT_EQUAL_STRING("*scratch*", buf->filename);
+	TEST_ASSERT_TRUE(buf->special_buffer);
+	owTeardown();
+}
+
+/* Caller 3: C-x C-w. */
+void test_save_as_refuses_bad_path_without_asking(void) {
+	owSetup();
+	char p[128], a_path[128];
+	owWrite("x\ty", "precious\n");
+	owPath(p, sizeof(p), "x\ty");
+	owPath(a_path, sizeof(a_path), "a");
+	struct buffer *buf = owVisitA();
+
+	owRunBadName(doSaveAs);
+
+	TEST_ASSERT_EQUAL_INT(test_key_count - 1, test_key_pos);
+	clearKeys();
+	TEST_ASSERT_EQUAL_STRING(a_path, buf->filename);
+	TEST_ASSERT_EQUAL_STRING("mine\n", owRead("a"));
+	TEST_ASSERT_EQUAL_STRING("precious\n", owRead("x\ty"));
+	unlink(p);
+	owTeardown();
+}
+
+/* Caller 4: cd.  A relative name picks up the old directory's bytes. */
+static void runCd(const char *dir) {
+	int keys[64];
+	int n = 0;
+	for (const char *q = dir; *q && n < 60; q++)
+		keys[n++] = (unsigned char)*q;
+	keys[n++] = '\r';
+	scriptKeys(keys, n);
+	muteStdout();
+	changeDirectory();
+	unmuteStdout();
+	clearKeys();
+}
+
+void test_cd_refused_if_a_rebased_name_would_fail(void) {
+	char start[PATH_MAX], before[PATH_MAX], after[PATH_MAX];
+	TEST_ASSERT_NOT_NULL(getcwd(start, sizeof(start)));
+	owSetup();
+	char bad[128];
+	owPath(bad, sizeof(bad), "d\ty");
+	TEST_ASSERT_EQUAL_INT(0, mkdir(bad, 0700));
+	TEST_ASSERT_EQUAL_INT(0, chdir(bad));
+	TEST_ASSERT_NOT_NULL(getcwd(before, sizeof(before)));
+
+	struct buffer *good = make_test_buffer("x");
+	TEST_ASSERT_EQUAL_INT(0, bufferSetFilename(good, "/abs/name"));
+	struct buffer *rel = newBuffer();
+	TEST_ASSERT_EQUAL_INT(0, bufferSetFilename(rel, "f"));
+	rel->next = good;
+	E.headbuf = rel;
+
+	runCd("/");
+
+	TEST_ASSERT_NOT_NULL(getcwd(after, sizeof(after)));
+	TEST_ASSERT_EQUAL_STRING(before, after);
+	TEST_ASSERT_EQUAL_STRING("f", rel->filename);
+	TEST_ASSERT_EQUAL_STRING("/abs/name", good->filename);
+
+	E.headbuf = good;
+	destroyBuffer(rel);
+	TEST_ASSERT_EQUAL_INT(0, chdir(start));
+	rmdir(bad);
+	owTeardown();
+}
+
+/* Valid names still rebase, through the setter. */
+void test_cd_still_rebases_valid_names(void) {
+	char start[PATH_MAX], want[PATH_MAX];
+	TEST_ASSERT_NOT_NULL(getcwd(start, sizeof(start)));
+	owSetup();
+	char sub[128];
+	owPath(sub, sizeof(sub), "sub");
+	TEST_ASSERT_EQUAL_INT(0, mkdir(sub, 0700));
+	TEST_ASSERT_EQUAL_INT(0, chdir(sub));
+	struct buffer *buf = make_test_buffer("x");
+	TEST_ASSERT_EQUAL_INT(0, bufferSetFilename(buf, "f"));
+
+	runCd("..");
+
+	snprintf(want, sizeof(want), "sub/f");
+	TEST_ASSERT_EQUAL_STRING(want, buf->filename);
+	TEST_ASSERT_EQUAL_INT(0, chdir(start));
+	rmdir(sub);
+	owTeardown();
+}
