From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 13:37:15 +1100
Subject: [PATCH 13/15] Show a match as one line in *Completions*

A buffer's filename can hold a newline, and the buffer and search prompts wrote
it into a row as it was.  Both layouts now show it as ^J.  The match itself is
kept, so M-n and M-p still give the real name.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01947MBgCkoERXfoyRGfCmQi
---
 completion.c        | 23 ++++++++++++++++----
 tests/test_prompt.c | 51 +++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 70 insertions(+), 4 deletions(-)

diff --git a/completion.c b/completion.c
index c0307dc..bb262fc 100644
--- a/completion.c
+++ b/completion.c
@@ -255,6 +255,17 @@ void replaceMinibufferText(struct buffer *minibuf, const char *text) {
 	}
 }
 
+/* A match as one line of *Completions*.  A buffer name is a filename,
+ * which can hold any byte, and a row must not hold a newline, so it
+ * shows as ^J.  The match itself stays as it is for M-n and M-p. */
+static char *completionRowText(const char *name) {
+	size_t len = strlen(name);
+	/* The worst case is a byte becoming U+FFFD: three bytes. */
+	char *shown = xmalloc(len * 3 + 1);
+	utf8SanitizeLine((const uint8_t *)name, len, shown, len * 3 + 1);
+	return shown;
+}
+
 static void showCompletionsBuffer(char **matches, int n_matches,
 				  enum promptType type) {
 	/* Find or create completions buffer */
@@ -287,9 +298,10 @@ static void showCompletionsBuffer(char **matches, int n_matches,
 					break;
 				}
 			}
-			int len = (int)strlen(show);
+			char *shown = completionRowText(show);
 			insertRow(comp_buf, comp_buf->numrows,
-				  (const uint8_t *)show, len);
+				  (const uint8_t *)shown, strlen(shown));
+			free(shown);
 		}
 
 		/* Store match list for M-n/M-p navigation. */
@@ -313,8 +325,11 @@ static void showCompletionsBuffer(char **matches, int n_matches,
 
 		/* Build truncated copies for display. */
 		char **display = xmalloc(n_matches * sizeof(char *));
-		for (int i = 0; i < n_matches; i++)
-			display[i] = leftTruncate(matches[i], term_width - 2);
+		for (int i = 0; i < n_matches; i++) {
+			char *cut = leftTruncate(matches[i], term_width - 2);
+			display[i] = completionRowText(cut);
+			free(cut);
+		}
 
 		int max_width = 0;
 		for (int i = 0; i < n_matches; i++) {
diff --git a/tests/test_prompt.c b/tests/test_prompt.c
index fc2f35b..68d3d18 100644
--- a/tests/test_prompt.c
+++ b/tests/test_prompt.c
@@ -3,6 +3,8 @@
 
 #include "test.h"
 #include "test_harness.h"
+#include "buffer.h"
+#include "mutate.h"
 #include "prompt.h"
 #include "keymap.h"
 #include "unicode.h"
@@ -479,9 +481,58 @@ void test_confirm_yn_answer_recorded_in_macro(void) {
 	cleanupTestEditor();
 }
 
+/* ---- A buffer filename holding a newline ---- */
+
+/* '\n' is emil's row separator, never a byte in a row, but a filename can
+ * hold one and the buffer and search prompts list filenames.  A second TAB
+ * lists both matches in *Completions*. */
+static void check_newline_name_listed(enum promptType type) {
+	initTestEditor();
+	makeMinibuffer();
+	struct buffer *cur = make_test_buffer("x");
+	E.edbuf = cur;
+	struct buffer *n1 = newBuffer(), *n2 = newBuffer();
+	n1->filename = xstrdup("qq\nyy");
+	n2->filename = xstrdup("qqz");
+	cur->next = n1;
+	n1->next = n2;
+
+	mutateInsert(E.minibuf, 0, 0, (const uint8_t *)"qq", 2, NULL, NULL);
+	E.minibuf->cx = 2;
+	E.minibuf->cy = 0;
+	muteStdout();
+	handleMinibufferCompletion(E.minibuf, type);
+	handleMinibufferCompletion(E.minibuf, type);
+	unmuteStdout();
+
+	struct buffer *list = findOrCreateSpecialBuffer("*Completions*");
+	int shown = 0;
+	for (int i = 0; i < list->numrows; i++) {
+		TEST_ASSERT(list->row[i].size == 0 ||
+			    memchr(list->row[i].chars, '\n',
+				   list->row[i].size) == NULL);
+		if (strstr((const char *)list->row[i].chars, "qq^Jyy"))
+			shown = 1;
+	}
+	TEST_ASSERT(shown);
+
+	freeMinibuffer();
+	cleanupTestEditor();
+}
+
+void test_buffer_prompt_lists_newline_name_on_one_row(void) {
+	check_newline_name_listed(PROMPT_BUFFER);
+}
+
+void test_search_prompt_lists_newline_name_on_one_row(void) {
+	check_newline_name_listed(PROMPT_SEARCH);
+}
+
 int main(void) {
 	TEST_BEGIN();
 
+	RUN_TEST(test_buffer_prompt_lists_newline_name_on_one_row);
+	RUN_TEST(test_search_prompt_lists_newline_name_on_one_row);
 	RUN_TEST(test_nested_prompt_preserves_buffer);
 	RUN_TEST(test_double_nested_prompt_preserves_buffer);
 	RUN_TEST(test_zap_arrow_key_does_not_corrupt_utf8);
