From 18d417cf84c61c6778c3c946927b7fde99318841 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 6 Nov 2026 13:42:20 +1100
Subject: [PATCH 15/15] Add EMIL_DEBUG_ROW_BYTES: abort if a newline byte
 enters a row

On in make sanitize, the key fuzzer and refcheck; not in normal builds.  It checks
insertRow, appendRowRaw and the writes in bulkInsertRaw and bulkDelete.  It tripped
once in the suite, on a test fixture: test_warnings built a row from "output\\n".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01947MBgCkoERXfoyRGfCmQi
---
 Makefile              |  2 +-
 buffer.c              |  2 ++
 buffer.h              | 17 +++++++++++++++++
 refcheck/build.sh     |  2 +-
 tests/fuzz_keys.sh    |  2 +-
 tests/test_buffer.c   | 33 +++++++++++++++++++++++++++++++++
 tests/test_warnings.c |  2 +-
 undo.c                |  3 +++
 8 files changed, 59 insertions(+), 4 deletions(-)

diff --git a/Makefile b/Makefile
index 7fb3cfe..760a620 100644
--- a/Makefile
+++ b/Makefile
@@ -120,7 +120,7 @@ check: test
 
 sanitize:
 	$(MAKE) clean
-	$(MAKE) CFLAGS="-g -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -fPIE -DEMIL_DEBUG_ROW_CACHE -DEMIL_DEBUG_FOCUS" \
+	$(MAKE) CFLAGS="-g -O1 -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -fPIE -DEMIL_DEBUG_ROW_CACHE -DEMIL_DEBUG_FOCUS -DEMIL_DEBUG_ROW_BYTES" \
 	        LDFLAGS="-fsanitize=address,undefined -pie" test
 
 # Sorry Dave
diff --git a/buffer.c b/buffer.c
index 05c38e6..5d7b0af 100644
--- a/buffer.c
+++ b/buffer.c
@@ -105,6 +105,7 @@ static void bufEnsureRowCap(struct buffer *bufr) {
 }
 
 void insertRow(struct buffer *bufr, int at, const uint8_t *s, size_t len) {
+	debugCheckRowBytes(s, len);
 	if (at < 0 || at > bufr->numrows)
 		return;
 
@@ -134,6 +135,7 @@ void insertRow(struct buffer *bufr, int at, const uint8_t *s, size_t len) {
  * buffer is being populated from disk.
  */
 void appendRowRaw(struct buffer *bufr, const uint8_t *s, size_t len) {
+	debugCheckRowBytes(s, len);
 	if (len > (size_t)INT_MAX - 1)
 		abort();
 
diff --git a/buffer.h b/buffer.h
index c49916f..1e5f9ed 100644
--- a/buffer.h
+++ b/buffer.h
@@ -13,6 +13,23 @@
 struct buffer;
 int rejectIfReadOnly(struct buffer *buf);
 
+/* '\n' is the row separator, never a byte in a row.  EMIL_DEBUG_ROW_BYTES
+ * aborts if one is about to enter a row; every write of new bytes into a
+ * row calls this first. */
+#ifdef EMIL_DEBUG_ROW_BYTES
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+static inline void debugCheckRowBytes(const uint8_t *s, size_t len) {
+	if (len > 0 && memchr(s, '\n', len) != NULL) {
+		fprintf(stderr, "EMIL_DEBUG_ROW_BYTES: newline byte entering a row\n");
+		abort();
+	}
+}
+#else
+#define debugCheckRowBytes(s, len) ((void)0)
+#endif
+
 void insertRow(struct buffer *bufr, int at, const uint8_t *s, size_t len);
 void appendRowRaw(struct buffer *bufr, const uint8_t *s, size_t len);
 int killBufferNeedsConfirm(const struct buffer *bufr);
