diff --git a/mutate.c b/mutate.c
index f808fee..5351da0 100644
--- a/mutate.c
+++ b/mutate.c
@@ -261,3 +261,48 @@ enum mutateResult mutateExtendRows(struct buffer *buf, int from_row,
 	markBufferDirty(buf);
 	return MUTATE_DONE;
 }
+
+static uint8_t *wholeText(struct buffer *buf, int *len) {
+	int last = buf->numrows - 1;
+	return collectRegionText(buf, 0, 0, buf->row[last].size, last, len);
+}
+
+struct mutateRebuild mutateRebuildBegin(struct buffer *buf) {
+	struct mutateRebuild r = { NULL, 0 };
+	if (buf->undo != NULL || buf->redo != NULL)
+		r.old_text = wholeText(buf, &r.old_len);
+	bufferResetRows(buf);
+	return r;
+}
+
+void mutateRebuildEnd(struct buffer *buf, struct mutateRebuild *r) {
+	if (r->old_text == NULL)
+		return;
+
+	bufferEnsureRow(buf);
+	int new_len;
+	uint8_t *new_text = wholeText(buf, &new_len);
+
+	/* Put the old rows back, one per newline, then replace them. */
+	bufferResetRows(buf);
+	int start = 0, row = 0;
+	for (int i = 0; i <= r->old_len; i++) {
+		if (i == r->old_len || r->old_text[i] == '\n') {
+			insertRow(buf, row++, &r->old_text[start], i - start);
+			start = i + 1;
+		}
+	}
+
+	int read_only = buf->read_only;
+	int dirty = buf->dirty;
+	int last = buf->numrows - 1;
+	buf->read_only = 0;
+	mutateReplace(buf, 0, 0, buf->row[last].size, last, new_text, new_len,
+		      0, NULL, NULL);
+	buf->read_only = read_only;
+	buf->dirty = dirty;
+
+	free(new_text);
+	free(r->old_text);
+	r->old_text = NULL;
+}
diff --git a/mutate.h b/mutate.h
index 16326ef..8350d8d 100644
--- a/mutate.h
+++ b/mutate.h
@@ -28,6 +28,18 @@ enum mutateResult {
 	MUTATE_INVALID, /* no such range: nothing changed, and reported */
 };
 
+/* Rebuilding a special buffer's contents (*Completions*, register
+ * views, and so on): call Begin instead of bufferResetRows, fill the
+ * rows, then call End.  A buffer with no history just gets its new rows.
+ * One with history (made writable and edited) gets the change as an
+ * ordinary replace, so its history still matches its text. */
+struct mutateRebuild {
+	uint8_t *old_text; /* NULL when there is no history */
+	int old_len;
+};
+struct mutateRebuild mutateRebuildBegin(struct buffer *buf);
+void mutateRebuildEnd(struct buffer *buf, struct mutateRebuild *r);
+
 /* Delete text in [startx,starty]..[endx,endy], insert 'repl' at
  * (startx,starty).  Either the delete range or repl may be empty
  * (pure insert or pure delete).  Records a paired undo
